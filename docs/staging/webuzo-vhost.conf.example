# Webuzo / nginx vhost snippet for idepot-staging.lightworldtech.com
#
# HOW TO USE (docs/staging/staging-runbook.md §Deployment step 4):
#   Apply THROUGH the Webuzo panel (Domains/Subdomains + vhost editor +
#   Let's Encrypt), do NOT edit Webuzo's managed nginx config files directly.
#   This file is the exact intended result — paste the server blocks into the
#   vhost editor and issue the certificate for the staging subdomain.
#
# PREREQUISITE (owner/DNS): an A record (plus AAAA when the VPS has IPv6)
#   idepot-staging.lightworldtech.com.  ->  <VPS public IP>
#   Until that record exists and resolves, there is NO public staging URL and
#   none may be claimed.
#
# The upstream ports must match scripts/deploy/lib.sh defaults
#   (web 4310 / api 4311) and infra/pm2/idepot-staging.ecosystem.config.cjs.

server {
    listen 80;
    listen [::]:80;
    server_name idepot-staging.lightworldtech.com;

    # ACME challenge stays on HTTP for Webuzo/Let's Encrypt renewal
    location /.well-known/acme-challenge/ { root /usr/local/apps/nginx/var/html; }

    # everything else redirects to HTTPS
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name idepot-staging.lightworldtech.com;

    # certificate managed by Webuzo/Let's Encrypt for this subdomain
    ssl_certificate     /usr/local/apps/nginx/etc/ssl/certs/idepot-staging.lightworldtech.com/fullchain.pem;
    ssl_certificate_key /usr/local/apps/nginx/etc/ssl/certs/idepot-staging.lightworldtech.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # staging is not meant to be crawled
    add_header X-Robots-Tag "noindex, nofollow" always;

    # API -> NestJS on loopback
    location /api {
        proxy_pass http://127.0.0.1:4311;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # Web app -> Next.js standalone on loopback
    location / {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;      # HMR/websockets if ever enabled
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
