{
  "name": "@idepot/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free auth core: Argon2id hashing, JWT, device registry types, RBAC catalog + decision function",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@idepot/config": "*",
    "@types/jsonwebtoken": "^9.0.7"
  }
}
