# iDepot monorepo — example environment (copy to .env for local dev; NEVER commit real secrets)

# API
IDEPOT_API_PORT=3001
IDEPOT_JWT_SECRET=dev-only-secret-change-me
IDEPOT_JWT_ACCESS_TTL=900s
IDEPOT_JWT_REFRESH_TTL=30d

# Primary datastore (local dev). Tests use an embedded PostgreSQL — see packages/testing.
IDEPOT_DATABASE_URL=postgresql://idepot_app:idepot_app@127.0.0.1:5432/idepot

# Migration staging MySQL (isolated, disposable; legacy source is never mutated)
IDEPOT_MIGRATION_MYSQL_URL=mysql://idepot_migration:idepot_migration_local@127.0.0.1:3307/idepot_legacy_staging

# Migration run artifacts output directory
IDEPOT_MIGRATION_ARTIFACTS_DIR=./migration-artifacts
